# Copy to .env and fill in. The scaffold runs fully offline in MOCK mode by
# default (HOMOSAPIEN_LIVE=0), so you can explore the pipeline with no AWS setup.

# Set to 1 to call real models on Amazon Bedrock (requires AWS credentials +
# Bedrock model access enabled in the console).
HOMOSAPIEN_LIVE=0

# Bedrock model id used by the judgement-heavy sub-agents.
HOMOSAPIEN_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# AWS region for Bedrock. boto3 also reads this.
AWS_REGION=us-east-1

# Escalation threshold: grades/transcriptions below this confidence are handed
# back to the educator instead of being auto-applied.
HOMOSAPIEN_CONF_THRESHOLD=0.75
